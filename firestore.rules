rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admin authorization check:
    // 1. Authenticated Google user matching the official store owner email (verified)
    // OR
    // 2. Document exists in the /admins/{uid} collection
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == "advanicplus173@gmail.com" && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admin collection rules
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidId(adminId);
    }

    // Settings rules
    // Public can read general store configuration (isOpen, default ongkir, address)
    // Only verified admin can modify store settings
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(docId);
    }

    // Product validation helper
    function isValidProduct(data) {
      return (!('id' in data) || (data.id is string && data.id.size() <= 128))
        && (!('name' in data) || (data.name is string && data.name.size() > 0 && data.name.size() <= 200))
        && (!('price' in data) || (data.price is number && data.price >= 0))
        && (!('unit' in data) || (data.unit is string && data.unit.size() <= 50))
        && (!('category' in data) || (data.category is string && data.category.size() <= 100))
        && (!('image' in data) || (data.image is string && data.image.size() <= 500000))
        && (!('inStock' in data) || (data.inStock is bool))
        && (!('barcode' in data) || (data.barcode is string && data.barcode.size() <= 128))
        && (!('featured' in data) || (data.featured is bool))
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000));
    }

    // Products rules
    // Public can read product catalog
    // Only verified admin can create, update, or delete products
    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(request.resource.data) && ('name' in request.resource.data) && ('price' in request.resource.data);
      allow update: if isAdmin() && isValidId(productId) && isValidProduct(request.resource.data);
      allow delete: if isAdmin() && isValidId(productId);
    }

    // Order creation validation helper
    function isValidOrderCreate(data, secretToken) {
      return data.keys().hasAll([
        'id', 'createdAt', 'name', 'phone', 'deliveryMethod', 
        'items', 'subtotal', 'deliveryFee', 'total', 'status', 'secretToken'
      ])
      && data.id is string && data.id.size() > 0 && data.id.size() <= 64
      && data.secretToken is string && data.secretToken == secretToken && data.secretToken.size() >= 24
      && data.createdAt is string && data.createdAt.size() <= 64
      && data.name is string && data.name.size() > 0 && data.name.size() <= 100
      && data.phone is string && data.phone.size() >= 8 && data.phone.size() <= 30
      && (data.deliveryMethod == 'delivery' || data.deliveryMethod == 'pickup')
      && data.items is list && data.items.size() > 0 && data.items.size() <= 50
      && data.subtotal is number && data.subtotal >= 0
      && data.deliveryFee is number && data.deliveryFee >= 0
      && data.total is number && data.total >= 0
      && data.status == 'pending'
      && (!('assignedCourierId' in data) || data.assignedCourierId == null);
    }

    // Orders rules
    match /orders/{secretToken} {
      // 1. Single order read:
      // - Admin can read any order
      // - Customer can ONLY read if the document ID matches their unguessable secretToken (size >= 24)
      // - Knowing only the human orderId (e.g. #ORD-1234) does NOT grant access to customer PII
      allow get: if isValidId(secretToken) && (
        isAdmin() || 
        (secretToken.size() >= 24 && resource.data.secretToken == secretToken)
      );
      
      // 2. Listing orders: STRICTLY ADMIN ONLY. Public or arbitrary customers cannot query/scrape all orders
      allow list: if isAdmin();
      
      // 3. Create order: Anyone can place an order, but status must be 'pending' and the document ID must match secretToken
      allow create: if isValidId(secretToken) 
        && secretToken.size() >= 24
        && isValidOrderCreate(request.resource.data, secretToken);
      
      // 4. Update / Delete order: STRICTLY ADMIN ONLY
      allow update, delete: if isAdmin() && isValidId(secretToken);
    }

    // Health / Connection test doc
    match /test/{docId} {
      allow read: if true;
    }
  }
}
