{
  "entities": {
    "StoreSettings": {
      "title": "Store Settings",
      "description": "Global settings for Warung Amma Ika.",
      "type": "object",
      "properties": {
        "isOpen": { "type": "boolean" },
        "minOrder": { "type": "integer" },
        "contacts": {
          "type": "object",
          "properties": {
            "OWNER": { "type": "string" },
            "KURIR_DULLAH": { "type": "string" },
            "KURIR_LEMAN": { "type": "string" }
          }
        },
        "deliveryFeeDefault": { "type": "integer" },
        "storeAddress": { "type": "string" }
      },
      "required": ["isOpen", "minOrder", "contacts"]
    },
    "Product": {
      "title": "Product",
      "description": "A sembako product sold in the store.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "barcode": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "integer" },
        "unit": { "type": "string" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "inStock": { "type": "boolean" },
        "featured": { "type": "boolean" }
      },
      "required": ["id", "name", "price", "unit", "category", "image", "inStock"]
    },
    "Order": {
      "title": "Order",
      "description": "An order placed by a customer.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "buyerName": { "type": "string" },
        "phone": { "type": "string" },
        "customerPhone": { "type": "string" },
        "deliveryMethod": { "type": "string" },
        "address": { "type": "string" },
        "deliveryAddress": { "type": "string" },
        "benchmark": { "type": "string" },
        "notes": { "type": "string" },
        "deliveryNotes": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "integer" },
        "deliveryFee": { "type": "integer" },
        "total": { "type": "integer" },
        "status": { "type": "string" },
        "customerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "courier": { "type": "string" },
        "deliveryTime": { "type": "string" }
      },
      "required": ["id", "customerId", "name", "phone", "deliveryMethod", "items", "subtotal", "total", "status", "createdAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized administrator user.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "TestConnection": {
      "title": "Test Connection",
      "description": "Health check document for verifying backend connection.",
      "type": "object",
      "properties": {
        "status": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/settings/config": {
      "schema": "StoreSettings",
      "description": "Singleton configuration for the store."
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "List of products available in the store."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Orders received from customers."
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Authorized admin users."
    },
    "/test/{docId}": {
      "schema": "TestConnection",
      "description": "Connection test document for health checks."
    }
  }
}
